# Normaliza finais de linha: tudo como LF no repositório.
# Evita o "modificado fantasma" do routeTree.gen.ts em máquinas Windows (core.autocrlf).
* text=auto eol=lf

# Arquivos binários — nunca aplicar conversão de fim de linha.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.mp4   binary
*.zip   binary
